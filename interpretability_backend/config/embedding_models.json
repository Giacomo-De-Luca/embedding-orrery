{
  "query_prompt_map": {
    "Retrieval-document": "Retrieval-query",
    "Document": "SearchQuery",
    "document": "query"
  },
  "query_task_type_map": {
    "RETRIEVAL_DOCUMENT": "RETRIEVAL_QUERY"
  },
  "extra_prompt_names": ["s2p", "s2s"],
  "task_prefixes": {
    "default_task": "search",
    "tasks": [
      {
        "id": "search",
        "label": "Search",
        "query_prefix": "task: search result | query: ",
        "document_prefix": "title: none | text: ",
        "prompt_names": ["query", "Retrieval-query", "SearchQuery", "Retrieval", "Reranking", "BitextMining"]
      },
      {
        "id": "question_answering",
        "label": "Question answering",
        "query_prefix": "task: question answering | query: ",
        "document_prefix": "title: none | text: ",
        "prompt_names": ["QuestionAnswering"]
      },
      {
        "id": "fact_checking",
        "label": "Fact checking",
        "query_prefix": "task: fact checking | query: ",
        "document_prefix": "title: none | text: ",
        "prompt_names": ["FactChecking"]
      },
      {
        "id": "code_retrieval",
        "label": "Code retrieval",
        "query_prefix": "task: code retrieval | query: ",
        "document_prefix": "title: none | text: ",
        "prompt_names": ["CodeRetrieval", "InstructionRetrieval"]
      },
      {
        "id": "classification",
        "label": "Classification",
        "query_prefix": "task: classification | query: ",
        "prompt_names": ["Classification", "MultilabelClassification"]
      },
      {
        "id": "clustering",
        "label": "Clustering",
        "query_prefix": "task: clustering | query: ",
        "prompt_names": ["Clustering"]
      },
      {
        "id": "sentence_similarity",
        "label": "Sentence similarity",
        "query_prefix": "task: sentence similarity | query: ",
        "prompt_names": ["STS", "SentenceSimilarity", "PairClassification"]
      }
    ]
  },
  "providers": {
    "sentence_transformers": [
      {"model": "all-MiniLM-L6-v2", "description": "Small and fast; the default text model"},
      {"model": "all-MiniLM-L12-v2"},
      {"model": "all-mpnet-base-v2"},
      {"model": "paraphrase-MiniLM-L6-v2"},
      {"model": "BAAI/bge-small-en-v1.5"},
      {"model": "BAAI/bge-base-en-v1.5"},
      {"model": "BAAI/bge-large-en-v1.5"},
      {
        "model": "google/embeddinggemma-300m",
        "description": "EmbeddingGemma: multilingual text with task prompts",
        "prompts": [
          "query", "document", "BitextMining", "Clustering", "Classification",
          "InstructionRetrieval", "MultilabelClassification", "PairClassification",
          "Reranking", "Retrieval", "Retrieval-query", "Retrieval-document", "STS",
          "Summarization"
        ],
        "prompt_format": "task_prefix",
        "max_length": 2048
      },
      {
        "model": "google/embeddinggemma-2",
        "description": "EmbeddingGemma 2: text, images, audio and video in one space",
        "modalities": ["text", "image", "audio", "video"],
        "prompts": [
          "query", "document", "BitextMining", "Classification", "Clustering",
          "CodeRetrieval", "Document", "FactChecking", "InstructionRetrieval",
          "MultilabelClassification", "PairClassification", "QuestionAnswering",
          "Reranking", "Retrieval", "Retrieval-query", "Retrieval-document", "STS",
          "SearchQuery", "SentenceSimilarity", "Summarization"
        ],
        "default_for": ["multimodal"],
        "encoders": {"image": "vision_config", "video": "vision_config", "audio": "audio_config"},
        "prompt_format": "task_prefix",
        "max_length": 8192
      }
    ],
    "openai": [
      {"model": "text-embedding-3-small"},
      {"model": "text-embedding-3-large"},
      {"model": "text-embedding-ada-002"}
    ],
    "cohere": [
      {"model": "embed-english-v3.0"},
      {"model": "embed-multilingual-v3.0"}
    ],
    "ollama": [
      {"model": "nomic-embed-text"},
      {"model": "mxbai-embed-large"}
    ],
    "gemini": [
      {"model": "gemini-embedding-001"},
      {
        "model": "gemini-embedding-2",
        "description": "Gemini Embedding 2: text with task prefixes",
        "prompt_format": "task_prefix"
      }
    ],
    "bge": [
      {"model": "BAAI/bge-m3"}
    ],
    "qwen": [
      {"model": "Qwen/Qwen3-Embedding-0.6B"}
    ],
    "huggingface_api": [
      {"model": "sentence-transformers/all-MiniLM-L6-v2"}
    ]
  }
}
